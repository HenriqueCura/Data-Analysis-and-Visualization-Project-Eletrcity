from pathlib import Path

import pandas as pd
import plotly.graph_objects as go


try:
    BASE_DIR = Path(__file__).resolve().parent
except NameError:
    BASE_DIR = Path.cwd()

DATA_DIR = BASE_DIR / "data"

df_diarios = pd.read_csv(DATA_DIR / "dados_diarios.csv")
df_diarios["Data"] = pd.to_datetime(df_diarios["Data"])
df_diarios = df_diarios.sort_values("Data")


PRICE_COL = "avg_price_eur_mwh"

METEO_CONFIGS = {
    "temperatura": {
        "label": "Temperatura media",
        "column": "temp_C_mean",
        "unit": "C",
        "color": "#D95F02",
        "aliases": ("temp", "temperatura", "temperature")
    },
    "precipitacao": {
        "label": "Precipitacao",
        "column": "precip_mm_sum",
        "unit": "mm",
        "color": "#1F78B4",
        "aliases": ("precip", "precipitacao", "precipitation")
    },
    "nebulosidade": {
        "label": "Nebulosidade media",
        "column": "mean_cloud",
        "unit": "%",
        "color": "#6C757D",
        "aliases": ("cloud", "nuvens", "nebulosidade")
    },
    "luz": {
        "label": "Luz solar",
        "column": "Sunlight (em minutos)",
        "unit": "min",
        "color": "#F2B705",
        "aliases": ("luz", "sunlight", "solar")
    },
    "vento": {
        "label": "Vento medio",
        "column": "wind_speed_mean",
        "unit": "m/s",
        "color": "#2A9D8F",
        "aliases": ("vento", "wind", "wind_speed")
    }
}

PRICE_CONFIG = {
    "label": "Preco medio diario",
    "column": PRICE_COL,
    "unit": "EUR/MWh",
    "color": "#8E1B1B"
}

dropdown_options_preco_meteo = [
    {"label": "Todas as condicoes", "value": "todas"},
    {"label": "Temperatura media", "value": "temperatura"},
    {"label": "Precipitacao", "value": "precipitacao"},
    {"label": "Nebulosidade media", "value": "nebulosidade"},
    {"label": "Luz solar", "value": "luz"},
    {"label": "Vento medio", "value": "vento"}
]


def _normalize_key(value):
    if value is None:
        return "todas"

    value = str(value).strip().casefold()

    if value in {"todas", "todos", "all"}:
        return "todas"

    for key, config in METEO_CONFIGS.items():
        if value == key or value in config["aliases"]:
            return key

    valid_values = ["todas"] + list(METEO_CONFIGS)
    raise ValueError(f"Condicao invalida. Usa uma de: {valid_values}")


def _available_configs(condition):
    condition = _normalize_key(condition)

    if condition == "todas":
        return [PRICE_CONFIG] + [
            config
            for config in METEO_CONFIGS.values()
            if config["column"] in df_diarios.columns
        ]

    config = METEO_CONFIGS[condition]

    if config["column"] not in df_diarios.columns:
        raise ValueError(f"A coluna {config['column']} nao existe nos dados.")

    return [PRICE_CONFIG, config]


def _scale_0_1(series):
    min_value = series.min()
    max_value = series.max()

    if pd.isna(min_value) or pd.isna(max_value) or max_value == min_value:
        return series * 0

    return (series - min_value) / (max_value - min_value)


def _prepare_stream_data(condition="todas", rolling_window=7):
    configs = _available_configs(condition)
    cols = ["Data"] + [config["column"] for config in configs]

    stream_df = df_diarios[cols].dropna().copy()

    for config in configs:
        col = config["column"]
        scaled_col = f"{col}_scaled"

        stream_df[scaled_col] = _scale_0_1(stream_df[col].astype(float))

        if rolling_window and rolling_window > 1:
            stream_df[scaled_col] = (
                stream_df[scaled_col]
                .rolling(window=rolling_window, min_periods=1)
                .mean()
            )

    scaled_cols = [f"{config['column']}_scaled" for config in configs]
    total = stream_df[scaled_cols].sum(axis=1)
    baseline = -total / 2

    layers = []
    cumulative = baseline.copy()

    for config in configs:
        scaled_col = f"{config['column']}_scaled"
        lower = cumulative.copy()
        upper = cumulative + stream_df[scaled_col]

        layers.append({
            "config": config,
            "lower": lower,
            "upper": upper
        })

        cumulative = upper

    return stream_df, layers


def create_preco_meteocond_streamgraph(condicao="todas", rolling_window=7):
    stream_df, layers = _prepare_stream_data(
        condition=condicao,
        rolling_window=rolling_window
    )

    fig = go.Figure()

    for layer in layers:
        config = layer["config"]
        col = config["column"]
        lower_name = f"{col}_lower"

        fig.add_trace(go.Scatter(
            x=stream_df["Data"],
            y=layer["lower"],
            mode="lines",
            line=dict(width=0, color="rgba(0,0,0,0)"),
            hoverinfo="skip",
            showlegend=False,
            name=lower_name
        ))

        fig.add_trace(go.Scatter(
            x=stream_df["Data"],
            y=layer["upper"],
            mode="lines",
            fill="tonexty",
            fillcolor=config["color"],
            line=dict(color=config["color"], width=0.8),
            opacity=0.72,
            name=config["label"],
            customdata=stream_df[[col]].to_numpy(),
            hovertemplate=(
                f"{config['label']}"
                "<br>Data: %{x|%Y-%m-%d}"
                f"<br>Valor real: %{{customdata[0]:.2f}} {config['unit']}"
                "<extra></extra>"
            )
        ))

    fig.update_layout(
        template="plotly_white",
        width=None,
        autosize=True,
        height=540,
        title_x=0.5,
        hovermode="x unified",
        xaxis_title="Data",
        yaxis_title="Valor normalizado",
        legend_title="Variaveis",
        font=dict(size=14),
        margin=dict(l=55, r=35, t=45, b=95),
        legend=dict(
            orientation="h",
            yanchor="bottom",
            y=-0.32,
            xanchor="center",
            x=0.5
        )
    )

    fig.update_xaxes(
        showgrid=True,
        rangeslider_visible=True
    )

    fig.update_yaxes(
        showgrid=False,
        zeroline=True,
        zerolinecolor="#BFC7CE",
        showticklabels=False
    )

    return fig


def create_price_weather_streamgraph(condicao="todas", rolling_window=7):
    return create_preco_meteocond_streamgraph(
        condicao=condicao,
        rolling_window=rolling_window
    )


def create_streamgraph_preco_meteocond(condicao="todas", rolling_window=7):
    return create_preco_meteocond_streamgraph(
        condicao=condicao,
        rolling_window=rolling_window
    )


if __name__ == "__main__":
    fig = create_preco_meteocond_streamgraph("todas")
    fig.show()
